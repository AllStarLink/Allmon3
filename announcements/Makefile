install:
	install -D -m 0644 announcements.ini $(DESTDIR)/etc/allmon3/announcements.ini
	install -D -m 0644 speech.ini $(DESTDIR)/etc/allmon3/speech.ini
	install -D -m 0644 registration.ini $(DESTDIR)/etc/allmon3/addons.d/announcements.ini
	install -D -m 0644 time.ini $(DESTDIR)/etc/allmon3/time.ini
	install -D -m 0644 say-time.md $(DESTDIR)/usr/share/doc/allmon3/say-time.md
